# Telegram
BOT_TOKEN=123456:ABC-DEF
BOT_USERNAME=YourBotUsername
MINIAPP_SHORT_NAME=calendar
STARTAPP_SECRET=change-me-to-a-long-random-string

# Database (local Docker or Neon)
# Neon example: postgresql://USER:PASS@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_calendar?schema=public

# API / Mini App
API_HOST=0.0.0.0
API_PORT=3000
# On Fly, PORT is injected; PUBLIC_API_URL must be https://<app>.fly.dev
PUBLIC_API_URL=http://localhost:3000
PUBLIC_MINIAPP_URL=http://localhost:5173
INITDATA_MAX_AGE_SECONDS=86400

# Redis (local Docker or Upstash rediss://…)
REDIS_URL=redis://localhost:6379

# Bot mode: polling (local) | webhook (Fly production via apps/server)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
