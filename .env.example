# Telegram
BOT_TOKEN=123456:ABC-DEF
BOT_USERNAME=YourBotUsername
MINIAPP_SHORT_NAME=calendar
STARTAPP_SECRET=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_calendar?schema=public

# API / Mini App
API_HOST=0.0.0.0
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
PUBLIC_MINIAPP_URL=http://localhost:5173
INITDATA_MAX_AGE_SECONDS=86400

# Redis (reminders)
REDIS_URL=redis://localhost:6379

# Bot mode: polling | webhook
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
